VertexLitGeneric
{
	$basetexture "models/dih/hl2tower_angel/angel_face6"
	$bumpmap "models/dih/hl2tower_angel/shared/normal"


    $detail "models/dih/hl2tower_angel/detail/angel_face6"

$detailscale 1        // scales the detail texture to same size as diffuse texture.
  
$detailblendmode 5    // 6 also works. 1 can be used if both are unavailable 

	$lightwarptexture "models/dih/hl2tower_angel/shared/toon_all"

	$phong 1
	$phongfresnelranges "[0.5 0.75 1]"
	$phongexponent 5

	$rimlight 1
	$rimlightexponent 5
	$rimlightboost 3
}